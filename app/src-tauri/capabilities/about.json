{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "about",
  "description": "Permissions of the about window: open its links in the browser",
  "windows": ["about"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/CuriousTimo/*" }, { "url": "https://losse-eindj.es/*" }]
    }
  ]
}
